# ルームの保存先。firestore にすると Firestore 版（src/store/firestoreRoomStore.ts）を使う。
# 空か local なら、この端末の localStorage に置く版（src/store/localRoomStore.ts）を使う。
VITE_ROOM_STORE=local

# Firebase の Web アプリの設定。
# これらの値は秘密ではない。ブラウザに配る前提の値で、守りは Firestore のセキュリティルール（firestore.rules）が受け持つ。
# 本物の値は Firebase コンソール > プロジェクトの設定 > マイアプリ > ウェブアプリ にある。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 手元の Firebase Emulator Suite で動かす ---
# true にすると Auth と Firestore を手元のエミュレーター（npx firebase emulators:start）につなぐ。
# エミュレーターだけで動かすときは demo プロジェクトを使う（本物の Firebase プロジェクトは要らない）:
#   VITE_FIREBASE_PROJECT_ID=demo-cp-pair
#   （ほかの VITE_FIREBASE_* は空でない仮の値でよい）
VITE_USE_FIREBASE_EMULATOR=false
