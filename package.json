{
  "name": "cp-pair",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "node scripts/verify-matching.ts",
    "deploy": "wrangler deploy",
    "preview:branch": "wrangler preview",
    "test:e2e": "playwright test",
    "test:deploy": "vitest run test/deploy",
    "test:firestore": "firebase emulators:exec --only firestore \"vitest run test/firestore\"",
    "test:e2e:firestore": "firebase emulators:exec --only auth,firestore \"playwright test -c playwright.firestore.config.ts\"",
    "design:lint": "designmd lint DESIGN.md",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:lan": "storybook dev -p 6006 --host 0.0.0.0 --no-open"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^12.14.0",
    "motion": "^14.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "10.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.20.0",
    "oxlint": "^1.90.0",
    "storybook": "10.6.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.168.0"
  }
}
