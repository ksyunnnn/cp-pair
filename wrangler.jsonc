{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cppair",
  // Worker のスクリプトを置かず、ビルドした静的ファイルだけを配信する
  // https://developers.cloudflare.com/workers/static-assets/
  "compatibility_date": "2026-11-25",
  // 本番は workers.dev で配信する。main 以外のブランチは Workers Builds が Preview を作り、
  // その URL を PR にコメントする。Preview の URL には workers.dev の Preview URL を有効にする必要がある
  // https://developers.cloudflare.com/workers/ci-cd/builds/troubleshoot/
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // 見つからない画面の経路は index.html を返し、画面の振り分けを SPA に任せる
    // https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
    "not_found_handling": "single-page-application",
  },
}
