{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cppair",
  // Worker のスクリプトを置かず、ビルドした静的ファイルだけを配信する
  // https://developers.cloudflare.com/workers/static-assets/
  "compatibility_date": "2026-11-25",
  // 本番の URL はカスタムドメインの cppair.synsk.me。この設定には routes を置かず、カスタムドメインは Cloudflare 側で設定する。
  // 本番の workers.dev の URL は配信しない。止めても Preview の URL は止まらない
  // https://developers.cloudflare.com/workers/configuration/routing/workers-dev/
  // main 以外のブランチは Workers Builds が Preview を作り、その URL を PR にコメントする。
  // preview_urls を書かないと workers_dev に合わせて無効になるため、true を明示する
  // https://developers.cloudflare.com/workers/ci-cd/builds/troubleshoot/
  // https://developers.cloudflare.com/workers/versions-and-deployments/version-urls/
  "workers_dev": false,
  "preview_urls": true,
  // Preview コマンドの wrangler preview は、previews のブロックがないと止まる。中身は空でよい。
  // 静的アセットと互換日は上の階層の値を使うので、ここには書かない
  // https://developers.cloudflare.com/workers/previews/configuration/#wrangler-configuration-file
  "previews": {},
  "assets": {
    "directory": "./dist",
    // 見つからない画面の経路は index.html を返し、画面の振り分けを SPA に任せる
    // https://developers.cloudflare.com/workers/static-assets/routing/single-page-application/
    "not_found_handling": "single-page-application",
  },
}
